{
  "manifest_version": 3,
  "name": "Design DNA — Ultimate Extractor",
  "version": "2.1.0",
  "description": "Extract every design detail and generate AI-enhanced DESIGN.md specifications. Supports colors, typography, layout, animations (GSAP/Lottie/Three.js/Framer/anime), interactions, Shadow DOM, and more.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract Design DNA",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["extractors/*.js", "lib/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}